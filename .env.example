# Required for Cloudflare Workers AI models
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_WORKERS_AI_TOKEN=your_workers_ai_token

# Optional: protect access to the app with a password
APP_PASSWORD=

# Required only when using Google models through Cloudflare AI Gateway
CF_AI_GATEWAY_NAME=your_ai_gateway_name
# Set this only if your gateway requires a token
CF_AI_GATEWAY_TOKEN=
GOOGLE_API_KEY=your_google_ai_studio_api_key
# Comma-separated provider names; Google models are hidden unless this includes google
NEXT_PUBLIC_CF_AI_GATEWAY_PROVIDERS=google
